# nginx: Pixel Territory 컨테이너(127.0.0.1:3000)로 넘겨 주기.
# 이미 3000번으로 넘기는 설정이 있다면, 웹소켓을 위한 Upgrade / Connection 헤더와 긴 read timeout만 더하면 된다.

# http { } 안에 한 번 (이미 있으면 생략)
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl;
    server_name example.com;                       # 내 도메인
    # ssl_certificate / ssl_certificate_key 는 지금 쓰는 설정 그대로

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;    # 게임 웹소켓 (/ws)
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;                  # 판이 오래 열려 있어도 끊지 않게
        proxy_send_timeout 3600s;
        proxy_buffering off;                       # 상태 메시지를 모으지 않고 바로
    }
}
